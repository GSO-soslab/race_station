<?xml version="1.0"?>

<robot name="race_station">
   <link name="nose_tip_link">
   <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <!-- <visual>
            <origin xyz="00.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <mesh filename="package://race_station_description/mesh/RACE_body.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual> -->
    </link>


    <link name="base_link"/>
    <joint name="base_link" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="nose_tip_link"/>
    </joint>

    <link name="cg_link"/>
    <joint name="cg_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="3.1415926 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="cg_link"/>
    </joint>

    <link name="dock_point"/>
    <joint name="dock_point_joint" type="fixed">
        <origin xyz="-0.410 0.325 -0.04" rpy="3.1415926 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="dock_point"/>
    </joint>

    <link name="imu"/>
    <joint name="imu_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="imu"/>
    </joint>

    <link name="imu_sf"/>
    <joint name="imu__sf_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="imu_sf"/>
    </joint>

    <link name="gps"/>
    <joint name="gps_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="gps"/>
    </joint>

    <link name="pressure"/>
    <joint name="pressure_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="pressure"/>
    </joint>

    <!-- <link name="cam1"/>
    <joint name="cam1_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="cam1"/>
    </joint>

    <link name="cam2"/>
    <joint name="cam2_joint" type="fixed">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="cam2"/>
    </joint> -->

    <!--
        AprilTag links.
        Convention: <prefix><family>_<id>, where <family> is the pupil_apriltags
        family name without the "tag" prefix (e.g. "25h9", "36h11"). The numeric
        id is per-family: two tags in different families may share the same id.

        Frames mirror world_of_stonefish/vehicles/race_station.scn: every
        apriltag is parented to dock_point with the joint origin taken
        directly from the SCN.
    -->

    <!-- 3 x tag25h9 (27 cm) -->
    <link name="apriltag25h9_02"/>
    <joint name="apriltag25h9_02_joint" type="fixed">
        <origin xyz="-0.81 0.0 -0.21" rpy="-1.5707963 0.0 -1.5707963"/>
        <parent link="dock_point"/>
        <child link="apriltag25h9_02"/>
    </joint>

    <link name="apriltag25h9_13"/>
    <joint name="apriltag25h9_13_joint" type="fixed">
        <origin xyz="-0.26 0.37 -0.21" rpy="-1.5707963 0.0 3.1415926"/>
        <parent link="dock_point"/>
        <child link="apriltag25h9_13"/>
    </joint>

    <link name="apriltag25h9_17"/>
    <joint name="apriltag25h9_17_joint" type="fixed">
        <origin xyz="-0.26 -0.37 -0.21" rpy="-1.5707963 0.0 0.0"/>
        <parent link="dock_point"/>
        <child link="apriltag25h9_17"/>
    </joint>

    <!-- 3 x tag36h11 (15 cm) -->
    <link name="apriltag36h11_146"/>
    <joint name="apriltag36h11_146_joint" type="fixed">
        <!-- <origin xyz="0.430 0.0 0.405" rpy="0.0 1.5707963 0.0"/> -->
        <origin xyz="0.430 0.0 0.405" rpy="-1.5707963 0.0 -1.5707963"/>
        <parent link="dock_point"/>
        <child link="apriltag36h11_146"/>
    </joint>

    <link name="apriltag36h11_176"/>
    <joint name="apriltag36h11_176_joint" type="fixed">
        <origin xyz="0.0 0.25 -0.012" rpy="3.1415926 0.0 -1.5707963"/>
        <parent link="dock_point"/>
        <child link="apriltag36h11_176"/>
    </joint>

    <link name="apriltag36h11_185"/>
    <joint name="apriltag36h11_185_joint" type="fixed">
        <origin xyz="0.0 -0.25 -0.012" rpy="3.1415926 0.0 -1.5707963"/>
        <parent link="dock_point"/>
        <child link="apriltag36h11_185"/>
    </joint>

    <!-- 2 x tag36h11 (5 cm) -->
    <link name="apriltag36h11_541"/>
    <joint name="apriltag36h11_541_joint" type="fixed">
        <origin xyz="0.470 0.0 0.160" rpy="-1.5707963 0.0 -1.5707963"/>
        <parent link="dock_point"/>
        <child link="apriltag36h11_541"/>
    </joint>

    <link name="apriltag36h11_558"/>
    <joint name="apriltag36h11_558_joint" type="fixed">
        <origin xyz="0.470 0.0 0.095" rpy="-1.5707963 0.0 -1.5707963"/>
        <parent link="dock_point"/>
        <child link="apriltag36h11_558"/>
    </joint>

</robot>